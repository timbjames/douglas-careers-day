# Copy to .env and change these before the event.
POSTGRES_PASSWORD=change-me
# Use something longer than 4 digits: pupils will be on the same network.
ADMIN_PIN=change-me-too
# Port the site is served on (http://localhost:${WEB_PORT})
WEB_PORT=80
# Address phones should use to reach the site, shown as a QR code on /screen,
# e.g. http://192.168.1.50 (your laptop's IP on the event wifi/hotspot).
# Leave blank to use whatever address the big screen was opened on.
PUBLIC_URL=
